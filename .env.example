# ── Waitlist storage (server-side only — never exposed to the client) ──────
# Create a Supabase project, run supabase/schema.sql, then fill these in.
# On Vercel: Project → Settings → Environment Variables.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ── Signup notifications via Resend (optional — skipped when unset) ────────
# Create a free account at resend.com, then API Keys → Create API Key.
RESEND_API_KEY=re_YOUR-API-KEY
# Where notifications go:
WAITLIST_NOTIFY_TO=info@renovolabs.eu
# Sender. The resend.dev sandbox sender works immediately but only delivers
# to your own Resend account email; verify renovolabs.eu in Resend
# (Domains → Add Domain) and switch to e.g. "Renovo Labs <waitlist@renovolabs.eu>".
WAITLIST_NOTIFY_FROM="Renovo Labs <onboarding@resend.dev>"
